# Copy to .env.production. Never commit the populated file.
MODEL_PROVIDER=azure_foundry
MODEL=gpt-5.6-luna
CHAT_MODEL=
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=
REASONING_EFFORT=low

# The API and worker use separate disposable Docker volumes as local caches.
DATASET_CACHE_MB=256
VERIFY_DATASET_CHECKSUMS_ON_LOAD=false
INVESTIGATION_HISTORY_LIMIT=50
EVENT_STREAM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# Cloudflare R2 stores datasets, manifests, and completed investigations.
PERSISTENCE_BACKEND=s3
OBJECT_STORAGE_PREFIX=production
OBJECT_STORAGE_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=open-sports-analyst
OBJECT_STORAGE_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Neon stores durable jobs, progress events, leases, and retries.
JOB_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DATABASE_MIGRATION_URL=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
JOB_POLL_SECONDS=5
JOB_IDLE_POLL_SECONDS=60
JOB_LEASE_SECONDS=300
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=7200

# Token from Cloudflare Zero Trust > Networks > Tunnels. cloudflared reads
# TUNNEL_TOKEN directly; configure the tunnel's public hostname to api:8080.
TUNNEL_TOKEN=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=open-sports-analyst-personal
