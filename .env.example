MODEL_PROVIDER=azure_foundry
MODEL=
CHAT_MODEL=
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=
REASONING_EFFORT=low
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
SQL_ROW_LIMIT=10000
EVENT_STREAM_TIMEOUT_SECONDS=120
DATASET_CACHE_MB=384
VERIFY_DATASET_CHECKSUMS_ON_LOAD=false
INVESTIGATION_HISTORY_LIMIT=50
LOG_LEVEL=INFO

# Local is the desktop/default mode. Use s3 for durable cloud object storage.
PERSISTENCE_BACKEND=local
OBJECT_STORAGE_PREFIX=open-sports-analyst
# For cloud providers such as Cloudflare R2 or another S3-compatible service
#PERSISTENCE_BACKEND=s3
#OBJECT_STORAGE_PREFIX=production

OBJECT_STORAGE_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=open-sports-analyst
OBJECT_STORAGE_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

JOB_BACKEND=local
JOB_DISPATCH_BACKEND=none
JOB_PROGRESS_TRANSPORT=stream
# Cloud Run deployment sets dispatch=cloud_run, transport=poll, and admission limit=3.
# See docs/cloud-run.md; desktop defaults require none of these cloud settings.
#CLOUD_RUN_PROJECT=
#CLOUD_RUN_REGION=us-central1
#CLOUD_RUN_WORKER_JOB=
#CLOUD_RUN_SYNC_SERVICE_URL=
#CLOUD_TASKS_QUEUE=
#CLOUD_TASKS_SERVICE_ACCOUNT=
MAX_ACTIVE_JOBS=0
# The Windows desktop automatically uses an AppData-backed SQLite ledger.
# The recommended Cloud Run deployment sets JOB_BACKEND=object.
JOB_POLL_SECONDS=5
JOB_IDLE_POLL_SECONDS=60
JOB_LEASE_SECONDS=300
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=7200
# Retry a rejected/failed Cloud Run dispatch after this many seconds.
JOB_DISPATCH_RETRY_SECONDS=30
# Suppress duplicate dispatches while Cloud Run provisions an accepted execution.
JOB_DISPATCH_STARTUP_SECONDS=900

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=open-sports-analyst-local
#LANGSMITH_WORKSPACE_ID=
