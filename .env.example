# Local development and Windows desktop settings.
# Copy to .env, enter your model settings, and never commit credentials.
# See docs/environment.md for details.

# Analysis model (Azure Foundry)
MODEL_PROVIDER=azure_foundry
MODEL=YOUR_ANALYSIS_DEPLOYMENT
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=
REASONING_EFFORT=low

# Optional separate deployment for summaries/follow-up wording, not analysis.
# Omit to reuse MODEL.
#CHAT_MODEL=YOUR_CHAT_DEPLOYMENT
# Optional reasoning effort for CHAT_MODEL only; omit/leave blank for the model default.
# Use a value supported by that deployment.
#CHAT_REASONING_EFFORT=low

# Optional Understat enrichment through the locked SoccerData parser.
SOCCER_UNDERSTAT_ENABLED=true

# Alternative provider: only needed with MODEL_PROVIDER=ollama.
#OLLAMA_BASE_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=qwen3:8b

# Storage: omit DATA_DIR to keep the standard per-user data directory.
# Changing this path does not migrate existing datasets or history.
#DATA_DIR=./data
PERSISTENCE_BACKEND=local

# The development server runs jobs in-process. The Windows launcher automatically
# uses a persistent SQLite queue and starts its worker; no manual changes needed.
JOB_BACKEND=local
JOB_PROGRESS_TRANSPORT=stream

# Performance and diagnostics
DATASET_CACHE_MB=384
DATASET_SYNC_CONCURRENCY=8
LOG_LEVEL=INFO
# Optional overrides; the values below are already the defaults.
#SQL_ROW_LIMIT=10000
#EVENT_STREAM_TIMEOUT_SECONDS=120
#VERIFY_DATASET_CHECKSUMS_ON_LOAD=false
#INVESTIGATION_HISTORY_LIMIT=50
#MAX_ACTIVE_JOBS=0

# Optional CFB sources: review docs/cfb-source-terms.md before enabling.
# Each operator must acknowledge source terms before enabling either source.
# CFBD may cache a checksum-verified season asset up to 160 MiB.
CFB_NCAA_ENABLED=true
CFB_CFBD_ENABLED=true
CFB_SECONDARY_USAGE_CONFIRMED=true

# Optional tracing; not needed to run the application.
LANGSMITH_TRACING=false
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#LANGSMITH_API_KEY=
#LANGSMITH_PROJECT=open-sports-analyst
#LANGSMITH_WORKSPACE_ID=

# Advanced desktop worker tuning normally needs no changes; see config.py.
# Windows signing variables are build-only process variables, not runtime settings.
# Optional in-process QuickJS analytical composition; no LangSmith key needed.
CALCULATION_INTERPRETER_ENABLED=true
# Model calls per planning turn; acquisition rounds remain separately bounded.
CALCULATION_MODEL_CALL_LIMIT=24
# Optional bounded WhoScored event enrichment; blocked sources remain coverage gaps.
SOCCER_WHOSCORED_ENABLED=true
